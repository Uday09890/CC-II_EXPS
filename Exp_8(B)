#include <bits/stdc++.h>
using namespace std;

int solve(int i, vector<int>& height, int k, vector<int>& dp) {
    if (i == 0)
        return 0;

    if (dp[i] != -1)
        return dp[i];

    int minCost = INT_MAX;

    for (int j = 1; j <= k; j++) {
        if (i - j >= 0) {
            int cost = solve(i - j, height, k, dp)
                     + abs(height[i] - height[i - j]);

            minCost = min(minCost, cost);
        }
    }

    return dp[i] = minCost;
}

int frogJump(int n, vector<int>& height, int k) {
    vector<int> dp(n, -1);
    return solve(n - 1, height, k, dp);
}

int main() {
    int n, k;
    cin >> n >> k;

    vector<int> height(n);
    for (int i = 0; i < n; i++)
        cin >> height[i];

    cout << frogJump(n, height, k) << endl;

    return 0;
}
